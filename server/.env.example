# Flask
SECRET_KEY=                        # Required — set a long random string
JWT_SECRET_KEY=                    # Required — set a different long random string
DEBUG=false

# Database
SQLALCHEMY_DATABASE_URI=sqlite:///database.db

# Admin credentials — created on first run
ADMIN_EMAIL=                       # Required
ADMIN_PASSWORD=                    # Required — min 8 chars, include a number

# Redis
REDIS_URL=redis://localhost:6379/0

# Mail (required for reminders and monthly reports)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=                     # Required
MAIL_PASSWORD=                     # Required — use Gmail App Password
MAIL_DEFAULT_SENDER=noreply@placement.edu

# CORS
ALLOWED_ORIGINS=http://localhost:5173

# Server
PORT=5000
